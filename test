#!/usr/bin/env bash
# Master test runner: unit + integration tests + README doctests (NOT benchmarks/fuzz).
# Uses `set -u` only — never `set -e` (it would abort on the first error-path test).
# Accumulates failures across sub-suites and returns the combined status.
set -u
cd "$(dirname "$0")"

exec nix develop --command bash -c '
	set -u
	export PLTCOLLECTS="$PWD:"   # make the in-repo racket-sugar collection resolve
	status=0
	raco test \
		tests/racket-sugar-test.rkt \
		tests/examples-test.rkt \
		tests/hamt-test.rkt \
		tests/pvector-test.rkt \
		tests/property-tests.rkt \
		tests/doctest-test.rkt \
		tests/hash-api-test.trk \
		tests/pvector-api-test.trk || status=1
	racket tools/doctest.rkt README.md || status=1
	exit $status
'
