#lang racket-sugar/typed

;; Typed in-place mutable-vector quicksort.
: swap! ((Vectorof Integer) Integer Integer ~-> Void)
define (swap! v i j)
	let ((t (vector-ref v i)))
		vector-set! v i (vector-ref v j)
		vector-set! v j t

: partition! ((Vectorof Integer) Integer Integer ~-> Integer)
define (partition! v lo hi)
	let ((pivot (vector-ref v hi)))
		let loop ((i : Integer lo) (j : Integer lo))
			cond
				(>= j hi)
					swap! v i hi
					i
				(< (vector-ref v j) pivot)
					swap! v i j
					loop (+ i 1) (+ j 1)
				else
					loop i (+ j 1)

: qsort! ((Vectorof Integer) Integer Integer ~-> Void)
define (qsort! v lo hi)
	when (< lo hi)
		let ((p (partition! v lo hi)))
			qsort! v lo (- p 1)
			qsort! v (+ p 1) hi

define n (assert (string->number (vector-ref (current-command-line-arguments) 0)) exact-integer?)
define v (ann (make-vector n 0) (Vectorof Integer))
let loop ((i : Integer 0) (x : Integer 42))
	when (< i n)
		let ((nx (modulo (* 48271 x) 2147483647)))
			vector-set! v i nx
			loop (+ i 1) nx
qsort! v 0 (- n 1)
displayln
	let loop ((i : Integer 0) (acc : Integer 0))
		if (>= i n)
			acc
			loop (+ i 1) (modulo (+ acc (* (+ i 1) (vector-ref v i))) 1000000007)
