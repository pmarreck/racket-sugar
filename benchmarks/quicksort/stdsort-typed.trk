#lang racket-sugar/typed

;; Typed version using Racket's built-in `sort` (merge sort). Comparator is a typed
;; lambda with paren-grouped params -- no `ann` needed.
: make-data (Integer Integer ~-> (Listof Integer))
define (make-data n seed)
	let loop ((i : Integer 0) (x : Integer seed) (acc : (Listof Integer) '()))
		if (>= i n)
			acc
			let ((nx (modulo (* 48271 x) 2147483647)))
				loop (+ i 1) nx (cons nx acc)

: checksum ((Listof Integer) ~-> Integer)
define (checksum lst)
	let loop ((i : Integer 1) (l : (Listof Integer) lst) (acc : Integer 0))
		if (null? l)
			acc
			loop (+ i 1) (cdr l) (modulo (+ acc (* i (car l))) 1000000007)

define n (assert (string->number (vector-ref (current-command-line-arguments) 0)) exact-integer?)
displayln (checksum (sort (make-data n 42) (lambda ((a : Integer) (b : Integer)) (< a b))))
